<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Todo el tráfico va por HTTPS, salvo el Elasticsearch local de desarrollo. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- Host de la PC visto desde el emulador de Android. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- IP local de la PC para dispositivos físicos conectados a la misma red Wi-Fi -->
        <domain includeSubdomains="false">10.13.33.216</domain>
    </domain-config>
</network-security-config>
